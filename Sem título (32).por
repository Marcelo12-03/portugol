   escreva("\n", N[0],"\n", N[1],"\n", N[2],"\n", N[3],"\n", N[4],"\n", N[5],"\n", N[6],"\n", N[7],"\n", N[8],"\n", N[9],"\n", N[10],"\n", N[11],"\n", N[12],"\n", N[13],"\n", N[14],"\n", N[15],"\n", N[16],"\n", N[17],"\n", N[18],"\n", N[19])
  
  }
