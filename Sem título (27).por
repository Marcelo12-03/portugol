programa {
  funcao inicio() {
    inteiro Numero

    escreva ("Digite o numero que sera o parametro: ") leia (Numero)

    tabuada (Numero)
  }
  funcao tabuada (inteiro Valor) {
    inteiro Total

    escreva ("TABUADA DE ", Valor)
    escreva ("\n", Valor, " * 1 = ", Valor)
    Total = Valor * 2
    escreva ("\n", Valor, " * 2 = ", Total)
    Total = Valor * 3
    escreva ("\n", Valor, " * 3 = ", Total)
    Total = Valor * 4
    escreva ("\n", Valor, " * 4 = ", Total)
    Total = Valor * 5
    escreva ("\n", Valor, " * 5 = ", Total)
    Total = Valor * 6
    escreva ("\n", Valor, " * 6 = ", Total)
    Total = Valor * 7
    escreva ("\n", Valor, " * 7 = ", Total)
    Total = Valor * 8
    escreva ("\n", Valor, " * 8 = ", Total)
    Total = Valor * 9
    escreva ("\n", Valor, " * 9 = ", Total)
    Total = Valor * 10
    escreva ("\n", Valor, " * 10 = ", Total)
  }
}
